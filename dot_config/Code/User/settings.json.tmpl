{{- /*
  Generated by chezmoi - do not edit this file directly.

  Edit the per-extension fragment files instead, under:
    .chezmoitemplates/vscode-settings/<extension>.json

  Each fragment owns a disjoint set of settings keys. This whole file is
  re-rendered and overwritten on every `chezmoi apply`, so removing a key
  from a fragment removes it here too - no stray obsolete keys accumulate.

  To add a new extension's settings: drop a new .json file in that
  directory with its flat "key": value pairs. It's picked up automatically.

  Keys in the live file that match a pattern in
  .chezmoitemplates/vscode-settings-ignore.json (`*` matches any text) and
  that no fragment defines are carried over as they are. Since the rendered
  file then equals the live one, chezmoi only asks about other changes.
*/ -}}
{{- $managed := includeTemplate "vscode-managed-settings" . | fromJson -}}
{{- $patterns := include ".chezmoitemplates/vscode-settings-ignore.json" | fromJson -}}
{{- $live := joinPath .chezmoi.homeDir ".config/Code/User/settings.json" -}}
{{- $settings := dict -}}
{{- if stat $live -}}
{{-   $text := include $live -}}
{{-   if trim $text -}}
{{-     range $k, $v := $text | fromJsonc -}}
{{-       range $p := $patterns -}}
{{-         if and (not (hasKey $managed $k)) (regexMatch (printf "^%s$" (regexQuoteMeta $p | replace "\\*" ".*")) $k) -}}
{{-           $settings = set $settings $k $v -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ merge $settings $managed | toPrettyJson | trimSuffix "\n" }}
