{{- /*
  Generated by chezmoi - do not edit this file directly.

  Edit the per-extension fragment files instead, under:
    .chezmoitemplates/vscode-settings/<extension>.json

  Each fragment owns a disjoint set of settings keys. This whole file is
  re-rendered and overwritten on every `chezmoi apply`, so removing a key
  from a fragment removes it here too - no stray obsolete keys accumulate.

  To add a new extension's settings: drop a new .json file in that
  directory with its flat "key": value pairs. It's picked up automatically.
*/ -}}
{{- $fragments := (sortAlpha (glob (joinPath .chezmoi.sourceDir ".chezmoitemplates/vscode-settings/*.json"))) -}}
{{- $merged := dict -}}
{{- $owner := dict -}}
{{- range $path := $fragments -}}
{{-   $frag := include $path | fromJson -}}
{{-   range $k, $v := $frag -}}
{{-     if hasKey $owner $k -}}
{{-       fail (printf "vscode settings: key %q is defined in both %s and %s" $k (get $owner $k) $path) -}}
{{-     end -}}
{{-     $owner = set $owner $k $path -}}
{{-   end -}}
{{-   $merged = mergeOverwrite $merged $frag -}}
{{- end -}}
{{ $merged | toPrettyJson | trimSuffix "\n" }}
