[Unit]
Description=Hard-link mirror Dropbox folders to Seafile libraries

[Service]
Type=oneshot
ExecCondition=/bin/sh -c '[ "$(%h/.local/bin/dropbox status)" = "Up to date" ]'
ExecStart=/usr/bin/rsync -a --delete --link-dest=%h/Dropbox/Tor/ %h/Dropbox/Tor/ %h/Seafile/FamilySharedPhotos/
ExecStart=/usr/bin/rsync -a --delete --link-dest=%h/Dropbox/Familjen/ %h/Dropbox/Familjen/ %h/Seafile/FamilyFiles/Familjen/
ExecStart=/usr/bin/rsync -a --delete --link-dest=%h/Dropbox/YlvaKent/ %h/Dropbox/YlvaKent/ %h/Seafile/FamilyFiles/YlvaKent/
ExecStart=/usr/bin/rsync -a --delete "--link-dest=%h/Dropbox/Tor farmors/" "%h/Dropbox/Tor farmors/" "%h/Seafile/FamilyPhotos/Tor farmors/"
